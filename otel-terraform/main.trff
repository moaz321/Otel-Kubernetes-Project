resource "aws_vpc" "otel_vpc" {
  cidr_block = "10.0.0.0/16"

  tags = {
    Name = "otel-vpc"
  }
}

resource "aws_subnet" "otel_subnet" {
  vpc_id                  = aws_vpc.otel_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-2a"
  map_public_ip_on_launch = true

  tags = {
    Name = "otel-subnet"
  }
}

resource "aws_internet_gateway" "otel_igw" {
  vpc_id = aws_vpc.otel_vpc.id

  tags = {
    Name = "otel-igw"
  }
}

resource "aws_route_table" "otel_rt" {
  vpc_id = aws_vpc.otel_vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.otel_igw.id
  }

  tags = {
    Name = "otel-rt"
  }
}

resource "aws_route_table_association" "otel_rta" {
  subnet_id      = aws_subnet.otel_subnet.id
  route_table_id = aws_route_table.otel_rt.id
}

resource "aws_security_group" "otel_sg" {
  name        = "otel-sg"
  description = "Security group for Kubernetes"
  vpc_id      = aws_vpc.otel_vpc.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "Kubernetes API"
    from_port   = 6443
    to_port     = 6443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "NodePort Range"
    from_port   = 30000
    to_port     = 32767
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "otel-sg"
  }
}

resource "aws_key_pair" "otel_key" {
  key_name   = "otel-key"
  public_key = file("~/.ssh/id_rsa.pub")
}

resource "aws_instance" "master" {
  ami                         = "ami-0eab37cfdc33e8e65"
  instance_type               = "m7i-flex.large"
  subnet_id                   = aws_subnet.otel_subnet.id
  vpc_security_group_ids      = [aws_security_group.otel_sg.id]
  associate_public_ip_address = true
  key_name                    = aws_key_pair.otel_key.key_name
  user_data = file("bootstrap.sh")
  root_block_device {
    volume_size = 40
    volume_type = "gp3"
  }
  
  tags = {
    Name = "k8s-master"
  }
}
